discord_auth:
  token:  # Discord bot token
  client_id: 815553000470478850 # Discord Client ID
  client_secret:  # Discord Client Secret
  allowed_redirects:
    - http://localhost:3000/auth/sauron
    - http://localhost:8000/auth/sauron
    - https://reedwhisker.infinitybots.gg/auth/sauron
    - https://infinitybots.gg/auth/sauron
    - https://botlist.site/auth/sauron
    - https://infinitybots.xyz/auth/sauron

sites:
  frontend: https://reedwhisker.infinitybots.gg # Frontend URL
  api: https://spider.infinitybots.gg # API URL
  panel: https://panel.infinitybots.gg # Panel URL
  infernoplex: https://infernoplex.infinitybots.gg # Infernoplex URL

channels:
  bot_logs: 762077915499593738 # Bot Logs Channel
  mod_logs: 911907978926493716 # Mod Logs Channel
  apps: 1034075132030894100 # Apps Channel, should be a staff only channel
  vote_logs: 762077981811146752 # Vote Logs Channel
  ban_appeals: 870950610692878337 # Ban Appeals Channel
  auth_logs: 1075091440117498007 # Auth Logs Channel
  testing_lounge: 891611731699335209 # Testing Lounge Channel, auto-unclaims are announced here
  system: 762958420277067786 # System Channel
  uptime: 1083108330442076292 # Uptime Channel
  staff_logs: 1186195848497999912 # Staff Logs Channel
  blog_announcements: 0 # Channel a new (published) blog post is announced to. Announcements are skipped entirely when this is unset (optional)
  changelog_announcements: 0 # Channel a new (published) changelog entry is announced to. Announcements are skipped entirely when this is unset (optional)

roles:
  awaiting_staff: 1029058929361174678 # Awaiting Staff Role
  apps: 907729844605968454 # Apps Role
  cert_bot: 759468236999491594 # Certified Bot Role
  premium_roles:
    - 759468236999491594
  bot_developer: 758756147313246209 # Bot Developer Role
  certified_developer: 759468303344992266 # Certified Developer Role
  bot_role: 758652296459976715 # Role given to bots joining the main server
  bug_hunters: 1042546603795427398 # Bug Hunters Role
  top_reviewers: 1239696066350420038 # Top Reviewers Role

japi:
  key:  # JAPI Key. Get it from https://japi.rest

notifications:
  vapid_public_key: BIdUNSqYzqVjbdJhn8WK6SDYDVj85mKtctrEgj14KkjxIMerxQ9wywvvxECkuP8rL3s8zDgZSE9HSqW1wmhVPM8 # Vapid Public Key (https://www.stephane-quantin.com/en/tools/generators/vapid-keys)
  vapid_private_key:  # Vapid Private Key (https://www.stephane-quantin.com/en/tools/generators/vapid-keys)

servers:
  main: 758641373074423808 # Main Server ID
  staff: 870950609291972618 # Staff Server ID
  testing: 870952645811134475 # Testing Server ID

meta:
  postgres_url: postgresql:///infinity # Postgres URL
  redis_url: redis://localhost:6379 # Redis URL
  port: :8081 # Port to run the server on
  vulgar_list:
    - fuck
    - suck
    - shit
    - kill
  urgent_mentions: <@&1061643797315993701> # Urgent mentions
  paypal_client_id:  # Paypal Client ID
  paypal_secret:  # Paypal Secret
  stripe_public_key:  # Stripe Public Key
  stripe_secret_key:  # Stripe Public Key
  popplio_proxy: https://gateway.nodebyte.host/proxy/discord # Popplio Proxy URL
  openai_api_key: sk-proj-your-key-here # OpenAI API key, used to run submitted bot/server descriptions through the (free) moderation endpoint at submission time, and to draft changelog entries. Moderation is skipped and the changelog generator falls back to a plain heuristic when this is unset (optional)
  github_token:  # GitHub PAT for the changelog generator's PR/compare lookups. Optional but strongly recommended -- unauthenticated GitHub API calls are capped at 60/hr and one generation can easily use 10+ (optional)
  blog_announce_mentions:  # Role mention(s) included in the blog-post announcement, e.g. '<@&123456789012345678>' -- put multiple mentions in one string to tag several roles. Skipped when empty (optional)
  changelog_announce_mentions:  # Role mention(s) included in the changelog-entry announcement, same shape as blog_announce_mentions. Skipped when empty (optional)

arcadia:
  token:  # Staff bot Discord token. This is a SEPARATE Discord application from Popplio's
  server_port: 3010 # Port the staff panel API listens on
  prefix_commands: false # Enable legacy prefix commands. Requires the privileged Message Content intent to be granted
  auto_mod: false # Enable passive auto-moderation (spam/invite-link/mass-mention scanning) in the main and testing servers. Requires the privileged Message Content intent, same as prefix_commands
  prefix: ibs! # Staff bot prefix, only used when prefix_commands is on
  owners:
    - 510065483693817867
  protected_bots:
    - 1019662370278228028
  panel:
    client_id:  # Discord client ID of the panel login app
    client_secret:  # Discord client secret of the panel login app
    redirect_url:
      - 
    panel_scope:  # Static handshake value the frontend sends
    panel_response_scope:  # Static handshake value the frontend expects back


infernoplex:
  client_id:  # Infernoplex bot Discord client ID
  client_secret:  # Infernoplex bot Discord client secret
  prefix: inf! # Infernoplex bot prefix
  server_port: 3012 # Port the Infernoplex bot API listens on
  token:  # Infernoplex bot Discord token

captcha:
  hmac_secret:  # Secret used to sign and verify proof-of-work vote captcha challenges. Generate with e.g. openssl rand -hex 32 — rotating it invalidates all outstanding challenges